[Unit]
Description=MAKER paper-trading supervisor (grok.py + dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Automated-Trading-Bot
# DASH_PORT 8013 to match the Mac setup; change if it collides with pais-api.
Environment=DASH_PORT=8013
ExecStart=/bin/bash /home/ubuntu/Automated-Trading-Bot/supervisor_paper.sh
# systemd restarts the supervisor itself if it ever dies; the supervisor in turn
# restarts grok.py within ~30s of any crash during market hours.
Restart=always
RestartSec=10
# Co-located with live pais-api on this 1GB box: hard-cap so the bot can never
# starve the product backend. If grok balloons, systemd OOM-kills THE BOT (it
# auto-restarts), never pais-api. Raise to 700M only on a dedicated box.
MemoryMax=500M
StandardOutput=append:/home/ubuntu/Automated-Trading-Bot/supervisor.log
StandardError=append:/home/ubuntu/Automated-Trading-Bot/supervisor.log

[Install]
WantedBy=multi-user.target
